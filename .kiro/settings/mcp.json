{
  "mcpServers": {
    "shadcn-ui": {
      "command": "uvx",
      "args": ["jpisnice-shadcn-ui-mcp-server@latest"],
      "env": {
        "GITHUB_TOKEN": "your_github_token_here",
        "FRAMEWORK": "react",
        "FASTMCP_LOG_LEVEL": "ERROR"
      },
      "disabled": false,
      "autoApprove": [
        "get_component",
        "list_components", 
        "get_block",
        "list_blocks",
        "get_demo",
        "search_components"
      ]
    },
    "shadcn-docs": {
      "command": "uvx",
      "args": ["ymadd-shadcn-ui@latest"],
      "env": {
        "FASTMCP_LOG_LEVEL": "ERROR"
      },
      "disabled": false,
      "autoApprove": [
        "list_components",
        "get_component_info",
        "search_components"
      ]
    }
  }
}
